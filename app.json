{
  "expo": {
    "name": "Matinee",
    "slug": "matinee",
    "scheme": "matinee",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "./plugins/withReleaseLintDisabled.js",
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantDisplayName": "Matinee"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131314"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0d7070aa-d7f7-4457-8430-843820c9a814"
      }
    },
    "android": {
      "package": "com.davebuilds.matinee",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#131314"
      }
    }
  }
}
