{
  "expo": {
    "name": "Matinee",
    "slug": "matinee",
    "scheme": "matinee",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantDisplayName": "Matinee"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
