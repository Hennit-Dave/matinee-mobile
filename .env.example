# Names only. Everything here is PUBLIC (bundled into the app). No secrets.
EXPO_PUBLIC_API_URL=

# Stripe publishable key (test mode), ADR 0019. PUBLIC by design: it identifies the Stripe account and cannot
# charge anyone. The SECRET key stays on the server, never in the app. Set it in the EAS dev build's env.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
